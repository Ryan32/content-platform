{
  "name": "@ae/content-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.3"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/check-build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "import:package": "payload run src/import/cli.ts",
    "processing": "payload run src/processing/cli.ts",
    "check:build": "node scripts/check-build.mjs",
    "check:config": "node scripts/check-config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1171.0",
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/client-transcribe": "3.1171.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@payloadcms/db-postgres": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "fast-xml-parser": "5.12.1",
    "fflate": "0.8.3",
    "graphql": "^16.11.0",
    "jose": "^6.2.3",
    "next": "16.4.6",
    "payload": "3.94.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "dompurify": "3.4.18",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "node": "24.22.3",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  }
}
