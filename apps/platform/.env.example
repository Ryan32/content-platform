# Configure this application separately from the root Vimeo diagnostic secret.
DATABASE_URI=postgresql://USER:PASSWORD@RDS_HOST:5432/content
PAYLOAD_SECRET=
PLATFORM_ORIGIN=https://library-dev.advisorsexcel.com
AUTH0_ISSUER=https://TENANT.auth0.com/
AUTH0_AUDIENCE=https://library-dev.advisorsexcel.com/mcp
# Browser sign-in (Regular Web Application). Keep the client secret and session secret out of source control.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# At least 32 characters; encrypts the session cookie. Not the Auth0 client secret or PAYLOAD_SECRET.
AUTH_SESSION_SECRET=
# Never disable RDS TLS verification. Supply the approved RDS CA bundle path.
DATABASE_CA_FILE=
